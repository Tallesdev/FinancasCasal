NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Fase D (áudio). Chave de SERVIDOR: sem NEXT_PUBLIC_, nunca chega ao
# navegador. Crie em console.groq.com. Sem ela o botão de áudio avisa que
# não está configurado e o resto do app segue normal.
GROQ_API_KEY=

# Excluir conta (LGPD). Chave SECRETA do Supabase (sb_secret_...), em
# Project Settings -> API Keys. Só servidor, NUNCA com NEXT_PUBLIC_: ela
# ignora RLS. Usada por /api/conta/excluir e pelas rotas de recibo (marcar
# envio conferido). Sem ela, excluir conta responde "não configurado" e
# recibos ficam desligados.
SUPABASE_SECRET_KEY=

# Aparecem em /privacidade e /termos. São públicos por natureza (é um
# contato), mas ficam fora do repositório porque ele é público. Prefira um
# e-mail dedicado ao app em vez do pessoal.
NEXT_PUBLIC_RESPONSAVEL_NOME=
NEXT_PUBLIC_CONTATO_EMAIL=

# Fase E (recibos). Cloudflare R2, todas de SERVIDOR (sem NEXT_PUBLIC_).
# Token com escopo SÓ do bucket, leitura e escrita de objeto. Sem estas
# quatro (ou sem SUPABASE_SECRET_KEY), o botão de anexar não aparece.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Ligação com o app de orçamentos (C27, C28). Todas de SERVIDOR. Clientes e
# serviços passam a ser os mesmos nos dois apps, e orçamento aprovado aparece
# em Recebimentos pra lançar. A chave secreta é a do projeto Supabase DO APP
# DE ORÇAMENTOS (sb_secret_..., Project Settings -> API Keys): ela ignora a
# RLS de lá, por isso o RumoFácil só a usa para a empresa abaixo.
# ORCAMENTOS_HOUSEHOLD_ID = id da empresa (households.id) no RumoFácil.
# ORCAMENTOS_COMPANY_ID é opcional enquanto o app de orçamentos tiver uma
# empresa só. Sem as três primeiras, Clientes e Serviços avisam que a ligação
# está desligada e a agenda funciona com cliente digitado.
ORCAMENTOS_SUPABASE_URL=
ORCAMENTOS_SUPABASE_SECRET_KEY=
ORCAMENTOS_HOUSEHOLD_ID=
ORCAMENTOS_COMPANY_ID=
